# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environments
.venv/
.venv-1/
venv/
env/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# SQLite databases (local only — cloud uses fresh DB)
*.db
*.db-shm
*.db-wal

# Environment / secrets
.env
.env.*
*.env

# Streamlit local secrets (never commit real secrets)
.streamlit/secrets.toml

# Sentinel runtime state (persists WhatsApp credentials in plaintext)
sentinel_state.json

# macOS
.DS_Store
*.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo

# Xcode
ios/**/xcuserdata/
*.xcuserstate
DerivedData/

# Test artifacts
.pytest_cache/
htmlcov/
.coverage

# Logs
*.log

# ML Models
models/*.pkl


# Historical CSV cache (downloaded data, not source)
data/historical_cache/

# Nightly run log; the artifacts beside it are committed, this is not
data/nightly_report.json

# Isolated feature worktrees
.worktrees/

# Dev environments symlinked into isolated worktrees (a symlink is not a dir,
# so the .venv/ and node_modules/ patterns above do not match it)
/.venv
/frontend/node_modules
